# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See orchestrator/config.py for how these are
# read (env vars win over .env; .env only fills in what's missing).

# --- Telegram (issue #19) ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID for the control/decisions channel (bidirectional - Lucas sends
# objectives/decisions, Jarvis sends blockers/NEEDS_LUCAS).
TELEGRAM_CONTROL_CHAT_ID=

# Chat ID for the daily-report channel (mostly read-only output).
TELEGRAM_REPORT_CHAT_ID=

# --- Paperclip ---
# Local orchestrator server. Default matches the running instance
# (loopback, local_trusted mode - no token needed on this machine).
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
# Optional for authenticated deployments; local_trusted loopback needs no token.
PAPERCLIP_API_TOKEN=
# Request timeout in seconds (positive, finite; fractions are supported).
# Same default as the existing Paperclip client. New orchestrator clients
# consume this setting; this does not reconfigure the legacy voice client.
PAPERCLIP_TIMEOUT_SECONDS=6

# --- Integration retry ---
# Seconds between retry attempts; positive and finite. Default: 30.
RETRY_INTERVAL_SECONDS=30

# --- Project context ---
# Canonical project metadata index; read by ProjectResolver on demand.
SECONDBRAIN_INDEX_PATH=A:\SecondBrain\project_context_index.json

# --- Scheduler (issue #25) ---
ORCHESTRATOR_TIMEZONE=Europe/Lisbon
CYCLE_START_TIME=08:00
CUTOFF_TIME=14:00
REPORT_TIME=17:00

# --- Agent rate limiting (issue #26) ---
# Fallback cooldown in minutes when an agent is rate-limited and no reset
# time is known.
RATE_LIMIT_BACKOFF_MINUTES=30

# --- Idle detection (issue #27) ---
# Minutes of no task activity (with READY work waiting and an agent free)
# before check_idle() investigates and reports a stall.
IDLE_CHECK_MINUTES=15

# --- GitHub client (issue #17), also used by the #37 auto-merge policy ---
# Timeout in seconds for each `gh` CLI invocation.
GITHUB_TIMEOUT_SECONDS=30
# Cap in seconds for the exponential backoff between retried GitHub
# operations (offline queue - issue #40).
GITHUB_MAX_BACKOFF_SECONDS=3600

# --- Paperclip resilience (issue #39) ---
# Cap in seconds for PaperclipSession's exponential backoff after
# repeated failures/detected restarts.
PAPERCLIP_MAX_BACKOFF_SECONDS=3600

# --- Telegram request timeouts (issue #19) ---
# Timeout in seconds for sending a message (report/control channel).
TELEGRAM_SEND_TIMEOUT_SECONDS=10
# Timeout in seconds for polling getUpdates (control channel intent parsing).
TELEGRAM_POLL_TIMEOUT_SECONDS=15

# --- Aggregated healthcheck (issue #36) ---
# A component's last heartbeat older than this (seconds) is reported stale.
HEARTBEAT_MAX_AGE_SECONDS=120
# A confirmed Telegram delivery older than this (seconds, default 48h) is
# reported stale.
TELEGRAM_HEALTH_MAX_AGE_SECONDS=172800

# --- Voice messages in the Telegram control channel (issue #148) ---
# Same Groq key main.py's own local voice loop uses (groq_apikey in the
# root config.py) - reused here so a voice message sent to the control
# channel is transcribed the same way. Leave empty to disable: a voice
# message then degrades to empty text, same as any unrecognized message.
GROQ_API_KEY=
# Whisper model used for transcription; matches main.py's take_command().
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
